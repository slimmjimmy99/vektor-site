---
import '../styles/base.css';
const { titulo, descricao } = Astro.props;
---
<!doctype html>
<html lang="pt-PT">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{titulo}</title>
  <meta name="description" content={descricao} />
  <meta name="theme-color" content="#0B2A3C" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preload" href="/fonts/space-grotesk-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>
  <main>
    <a class="brand" href="/" aria-label="Vektor Geoanalytics, página inicial">
      <svg width="34" height="34" viewBox="0 0 40 40" aria-hidden="true"><path d="M8 7 L20 33 L32 9" fill="none" stroke="#0B2A3C" stroke-width="4.5" stroke-linecap="square"/><path d="M13 14 Q20 22 27 15" fill="none" stroke="#1F6F50" stroke-width="1.6"/><path d="M16 19 Q20 25 24 20" fill="none" stroke="#549174" stroke-width="1.4"/><circle cx="8" cy="7" r="3.2" fill="none" stroke="#0B2A3C" stroke-width="2"/><circle cx="20" cy="33" r="3" fill="#C8692C"/><path d="M28 5 L36 6 L33 14 Z" fill="#C8692C"/></svg>
      <span><b>vektor</b><i>GEOANALYTICS</i></span>
    </a>
    <slot />
    <p class="small">© Vektor · Geoanalytics · <a href="/privacidade">Privacidade</a> · sem cookies nem analítica</p>
  </main>
</body>
</html>
