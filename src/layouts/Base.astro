---
import '../styles/base.css';
import { siInstagram, siGithub } from 'simple-icons';
const { titulo, descricao, imagem, largo = false } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);
const og = imagem ? new URL(`/estudos/${imagem}.jpg`, Astro.site) : null;
---
<!doctype html>
<html lang="pt-PT">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{titulo}</title>
  <meta name="description" content={descricao} />
  <meta name="theme-color" content="#0B2A3C" />
  <link rel="canonical" href={url} />
  <meta property="og:title" content={titulo} />
  <meta property="og:description" content={descricao} />
  <meta property="og:url" content={url} />
  <meta property="og:locale" content="pt_PT" />
  {og && <meta property="og:image" content={og} />}
  {og && <meta name="twitter:card" content="summary_large_image" />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preload" href="/fonts/space-grotesk-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>
  <header class="topo">
    <div class="wrap topo-in">
      <a class="brand" href="/" aria-label="Vektor Geoanalytics, página inicial">
        <svg width="30" height="30" viewBox="0 0 40 40" aria-hidden="true"><path d="M8 7 L20 33 L32 9" fill="none" stroke="#0B2A3C" stroke-width="4.5" stroke-linecap="square"/><path d="M13 14 Q20 22 27 15" fill="none" stroke="#1F6F50" stroke-width="1.6"/><path d="M16 19 Q20 25 24 20" fill="none" stroke="#549174" stroke-width="1.4"/><circle cx="8" cy="7" r="3.2" fill="none" stroke="#0B2A3C" stroke-width="2"/><circle cx="20" cy="33" r="3" fill="#C8692C"/><path d="M28 5 L36 6 L33 14 Z" fill="#C8692C"/></svg>
        <span><b>vektor</b><i>GEOANALYTICS</i></span>
      </a>
      <nav aria-label="Principal" class="menu">
        <a href="/#estudos">Estudos</a>
        <a href="/galeria">Galeria</a>
        <a href="/#sobre">Sobre</a>
        <a class="menu-cta" href="/pedir">Pedir um mapa</a>
      </nav>
    </div>
  </header>
  <main class:list={['wrap', { largo }]}>
    <slot />
  </main>
  <footer class="rodape">
    <div class="wrap rodape-in">
      <p>© Vektor · Geoanalytics · <a href="/pedir">Pedir um mapa</a> · <a href="/galeria">Galeria</a> · <a href="/privacidade">Privacidade</a> · sem cookies nem analítica</p>
      <p class="sociais">
        <a href="https://www.instagram.com/vektorgis" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={siInstagram.path} /></svg>Instagram</a>
        <a href="https://github.com/slimmjimmy99" rel="noopener" aria-label="GitHub"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={siGithub.path} /></svg>GitHub</a>
      </p>
    </div>
  </footer>
</body>
</html>
