---
import Base from '../layouts/Base.astro';
import { siInstagram, siGithub } from 'simple-icons';
---
<Base titulo="Vektor · Geoanalytics" descricao="Mapas e estudos com fonte, método e código. O território, em dados.">
  <span class="label">Caderno de análise geoespacial</span>
  <h1>O território, em dados.</h1>
  <p class="lead">Mapas e estudos com fonte, método e código. O caderno abre com o primeiro estudo completo.</p>
  <ul class="manifest">
    <li><span>01</span>Cada figura leva a fonte, a data e o sistema de coordenadas.</li>
    <li><span>02</span>Dados e software abertos sempre que possível; código no GitHub.</li>
    <li><span>03</span>Os números são calculados, não copiados.</li>
    <li><span>04</span>Os erros são corrigidos à vista, com data.</li>
  </ul>
  <div class="links">
    <a class="btn" href="https://www.instagram.com/vektorgis" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={siInstagram.path} /></svg>Instagram</a>
    <a class="btn ghost" href="https://github.com/slimmjimmy99" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={siGithub.path} /></svg>GitHub</a>
  </div>
  <div class="fig"><img src="/contornos.svg" alt="" width="1200" height="120" /></div>
</Base>
